{
  "name": "requant-wallet-app",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3320",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "node --test test/*.test.mjs gateway/test/*.test.mjs",
    "test:core": "cargo test -p requant-wallet-core",
    "check": "npm run build && npm test",
    "format": "prettier --write src scripts test gateway .github package.json vite.config.ts tsconfig.json src-tauri/*.json src-tauri/capabilities/*.json",
    "build:web-core": "node scripts/build-browser-core.mjs",
    "build:web": "node scripts/fetch-telegram-sdk.mjs && npm run build:web-core && tsc -p tsconfig.web.json --noEmit && vite build --config vite.web.config.ts && node scripts/package-web.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "test:web-core": "cargo test -p requant-browser-core -p requant-wallet-portable"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
