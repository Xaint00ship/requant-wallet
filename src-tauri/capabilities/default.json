{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "wallet",
  "description": "Wallet window and user-selected encrypted backup files",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write-text-file",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://requant.network/*"
        }
      ]
    }
  ]
}
