{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Requant Wallet",
  "version": "0.3.0",
  "identifier": "network.requant.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3320",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Requant Wallet",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Requant testnet wallet",
    "category": "Finance",
    "android": {
      "minSdkVersion": 26
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxRDcwQzk0RDc0QzM4QkIKUldTN09FelhsQXpYd1FTOEtMODJXMUthVFFjT29PTkdkSis5eHRRdmF0QUpza1RNR2U4eTkyOU4K",
      "endpoints": ["https://requant.network/updates/wallet/desktop.json"],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
